APP_ENV=development
PORT=8080
# Real Atlas credentials live in atlas-credentials.env (git-ignored), never here.
MONGODB_URI=mongodb+srv://USER:CHANGE_ME@CLUSTER.mongodb.net
# Development uses its own database (siagars_dev); production uses siagars. Never share them.
MONGODB_DATABASE=siagars_dev
PUBLIC_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=8
DEMO_MODE=true
SATUSEHAT_ENABLED=false
SATUSEHAT_ENV=sandbox
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=
# Read-only MSI Sandbox sync (go run ./cmd/manage sync-satusehat). Production is rejected.
SATUSEHAT_PAGE_LIMIT=200
SATUSEHAT_HTTP_TIMEOUT_SECONDS=10
# Empty = nationwide; "jabodetabek" or comma-separated 4-digit kab/kota codes (e.g. 3171,3276).
SATUSEHAT_KABKOTA=
# Only used by cmd/manage operator; do not commit actual credentials.
# Password min is 12 bytes, or 8 when APP_ENV=development (local throwaway accounts only).
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
OPERATOR_HOSPITAL_IDS=10000000-0000-4000-8000-000000000001
# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For is trusted for rate limiting.
# Empty (default) = header ignored and the TCP peer address is used. Example: 10.0.0.0/8,192.168.1.7
TRUSTED_PROXIES=
