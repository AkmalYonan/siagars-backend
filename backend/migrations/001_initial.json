   "latitude": {"bsonType": ["double", "null"], "minimum": -90, "maximum": 90}, "longitude": {"bsonType": ["double", "null"], "minimum": -180, "maximum": 180},
   "phone": {"bsonType": ["string", "null"]}, "bpjs": {"bsonType": ["bool", "null"]},
