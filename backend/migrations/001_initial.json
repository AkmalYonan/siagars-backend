    "data_origin": {"enum": ["curated", "simulation", "satusehat_sandbox", "satusehat_production"]},
    "source_url": {"bsonType": ["string", "null"]}, "source_updated_at": {"bsonType": ["date", "null"]}, "synced_at": {"bsonType": ["date", "null"]}, "verified_at": {"bsonType": ["date", "null"]},
