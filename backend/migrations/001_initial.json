   {"$eq": [{"$size": {"$setUnion": ["$beds.category", []]}}, {"$size": "$beds"}]},
   {"$allElementsTrue": [{"$map": {"input": "$beds", "in": {"$lte": [{"$ifNull": ["$$this.available", 0]}, {"$ifNull": ["$$this.total", 2147483647]}]}}}]}]}}},
 {"create": "operators", "validator": {
