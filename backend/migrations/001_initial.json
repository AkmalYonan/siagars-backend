   "beds": {"bsonType": "array", "items": {"bsonType": "object", "required": ["category", "total", "available", "data_origin", "version"], "properties": {
    "category": {"enum": ["icu", "nicu", "picu", "general"]},
    "total": {"bsonType": ["int", "long", "null"], "minimum": 0}, "available": {"bsonType": ["int", "long", "null"], "minimum": 0},
    "data_origin": {"enum": ["curated", "simulation", "satusehat_sandbox", "satusehat_production"]},
    "source_url": {"bsonType": ["string", "null"]}, "source_updated_at": {"bsonType": ["date", "null"]}, "synced_at": {"bsonType": ["date", "null"]}, "verified_at": {"bsonType": ["date", "null"]},
    "version": {"bsonType": ["int", "long"], "minimum": 1}}}}}},
  "$expr": {"$and": [
   {"$eq": [{"$eq": [{"$ifNull": ["$latitude", null]}, null]}, {"$eq": [{"$ifNull": ["$longitude", null]}, null]}]},
